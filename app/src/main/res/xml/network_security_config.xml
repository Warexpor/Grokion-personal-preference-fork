<?xml version="1.0" encoding="utf-8"?>
<!-- Cleartext is permitted so http://192.168.x.x (etc.) LAN LLM servers work.
     Android NSC cannot express RFC1918 CIDRs. App-layer [LanEndpointValidator]
     rejects cleartext to public IP literals. Cloud APIs still use HTTPS. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
