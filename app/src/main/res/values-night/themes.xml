<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- xAI: same dark-canvas system as day (forced dark) -->
    <style name="Theme.Grokion" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:windowBackground">@color/xai_canvas</item>
        <item name="colorSurface">@color/xai_canvas</item>
        <item name="colorOnSurface">@color/xai_body</item>
        <item name="colorPrimary">@color/xai_ink</item>
        <item name="colorOnPrimary">@color/xai_canvas</item>
        <item name="colorPrimaryContainer">@color/xai_canvas_soft</item>
        <item name="colorOnPrimaryContainer">@color/xai_ink</item>
        <item name="colorSecondary">@color/xai_mute</item>
        <item name="colorOnSecondary">@color/xai_canvas</item>
        <item name="colorSecondaryContainer">@color/xai_canvas_mid</item>
        <item name="colorOnSecondaryContainer">@color/xai_ink</item>
        <item name="colorTertiary">@color/xai_tertiary</item>
        <item name="colorOnTertiary">@color/xai_canvas</item>
        <item name="colorTertiaryContainer">@color/xai_canvas_soft</item>
        <item name="colorOnTertiaryContainer">@color/xai_ink</item>
        <item name="android:textColorPrimary">@color/xai_ink</item>
        <item name="android:textColorSecondary">@color/xai_mute</item>
        <item name="android:textColorHighlight">@color/xai_selected</item>
        <item name="colorControlActivated">@color/xai_ink</item>
        <item name="colorControlNormal">@color/xai_mute</item>
        <item name="android:colorControlNormal">@color/xai_mute</item>
        <item name="colorOutline">@color/xai_canvas_mid</item>
        <item name="colorOutlineVariant">@color/xai_hairline</item>
        <item name="colorSurfaceVariant">@color/xai_canvas_soft</item>
        <item name="colorOnSurfaceVariant">@color/xai_mute</item>
        <item name="colorSurfaceContainer">@color/xai_canvas_soft</item>
        <item name="colorSurfaceContainerHigh">@color/xai_canvas_card</item>
        <item name="colorSurfaceContainerHighest">@color/xai_canvas_mid</item>
        <item name="colorSurfaceContainerLow">@color/xai_canvas</item>
        <item name="colorSurfaceContainerLowest">@color/xai_canvas</item>
        <item name="colorError">@color/xai_error</item>
        <item name="colorOnError">@color/white</item>
        <item name="android:colorBackground">@color/xai_canvas</item>
        <item name="android:statusBarColor">@color/xai_canvas</item>
        <item name="android:navigationBarColor">@color/xai_canvas</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:colorAccent">@color/xai_ink</item>
        <item name="colorAccent">@color/xai_ink</item>
        <item name="materialAlertDialogTheme">@style/CustomMaterialAlertDialogTheme</item>
        <item name="android:fontFamily">@font/inter_regular</item>
        <item name="fontFamily">@font/inter_regular</item>
    </style>

    <style name="Widget.App.CheckBox" parent="Widget.Material3.CompoundButton.CheckBox">
        <item name="buttonTint">@color/button_tint</item>
        <item name="buttonIconTint">@color/button_icon_tint</item>
    </style>

    <style name="CustomMaterialAlertDialogTheme" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="android:backgroundDimAmount">0.6</item>
        <item name="shapeAppearanceMediumComponent">@style/XaiShapeCard</item>
        <item name="android:textColorPrimary">@color/xai_body</item>
        <item name="colorPrimary">@color/xai_ink</item>
        <item name="colorSurface">@color/xai_canvas_card</item>
        <item name="android:background">@color/xai_canvas_card</item>
        <item name="materialAlertDialogTitleTextStyle">@style/CustomDialogTitleText</item>
        <item name="materialAlertDialogBodyTextStyle">@style/CustomDialogBodyText</item>
        <item name="android:colorAccent">@color/xai_ink</item>
        <item name="buttonBarPositiveButtonStyle">@style/XaiDialogButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/XaiDialogButton</item>
        <item name="buttonBarNeutralButtonStyle">@style/XaiDialogButton</item>
    </style>

    <style name="XaiShapeCard" parent="ShapeAppearance.MaterialComponents.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">8dp</item>
    </style>

    <style name="ff" parent="XaiShapeCard" />

    <style name="XaiDialogButton" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="android:textColor">@color/xai_ink</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="CustomDialogTheme" parent="ThemeOverlay.Material3.Dialog.Alert">
        <item name="colorSurface">@color/xai_canvas_card</item>
        <item name="android:background">@color/xai_canvas_card</item>
        <item name="android:backgroundDimAmount">0.6</item>
        <item name="android:textColorPrimary">@color/xai_body</item>
        <item name="colorPrimary">@color/xai_ink</item>
        <item name="materialAlertDialogTitleTextStyle">@style/CustomDialogTitleText</item>
        <item name="materialAlertDialogBodyTextStyle">@style/CustomDialogBodyText</item>
    </style>

    <style name="CustomDialogBodyText" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/xai_body</item>
    </style>

    <style name="CustomDialogTitleText" parent="MaterialAlertDialog.Material3.Title.Text">
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">@color/xai_ink</item>
        <item name="android:textStyle">normal</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>

    <style name="RoundedCornersDialog" parent="Theme.MaterialComponents.DayNight.Dialog">
        <item name="android:backgroundDimAmount">0.6</item>
        <item name="android:windowBackground">@drawable/rounded_dialog_background</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowIsTranslucent">false</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="colorAccent">@color/xai_ink</item>
        <item name="colorPrimary">@color/xai_ink</item>
        <item name="colorSurface">@color/xai_canvas_card</item>
    </style>

    <style name="MyEditTextTheme" parent="ThemeOverlay.AppCompat.Dark">
        <item name="colorControlActivated">@color/xai_ink</item>
        <item name="colorControlNormal">@color/xai_hairline</item>
        <item name="android:textColorHint">@color/xai_mute</item>
    </style>

    <style name="Theme.Grokion.AIFix" parent="Theme.Grokion">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.6</item>
        <item name="android:windowAnimationStyle">@android:style/Animation.Dialog</item>
    </style>

    <style name="ShapeAppearance.Grokion.BottomSheet" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">16dp</item>
        <item name="cornerSizeTopRight">16dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <style name="Widget.Grokion.BottomSheet" parent="Widget.Material3.BottomSheet">
        <item name="shapeAppearance">@style/ShapeAppearance.Grokion.BottomSheet</item>
        <item name="backgroundTint">@color/xai_canvas_card</item>
    </style>

    <style name="ThemeOverlay.Grokion.BottomSheet" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.Grokion.BottomSheet</item>
        <item name="android:backgroundDimAmount">0.6</item>
        <item name="android:colorBackground">@color/xai_canvas_card</item>
    </style>
</resources>
