<?xml version="1.0" encoding="utf-8"?>
<!-- Grok M3-sized thumb: 24dp handle inside 32dp slot (matches mtrl_switch_thumb_size). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false" android:state_checked="true">
        <layer-list>
            <item
                android:width="32dp"
                android:height="32dp"
                android:gravity="center">
                <shape android:shape="oval">
                    <solid android:color="@android:color/transparent" />
                    <size android:width="32dp" android:height="32dp" />
                </shape>
            </item>
            <item
                android:width="24dp"
                android:height="24dp"
                android:gravity="center">
                <shape android:shape="oval">
                    <solid android:color="@color/thumbColorDisabled" />
                    <size android:width="24dp" android:height="24dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:state_enabled="false">
        <layer-list>
            <item
                android:width="32dp"
                android:height="32dp"
                android:gravity="center">
                <shape android:shape="oval">
                    <solid android:color="@android:color/transparent" />
                    <size android:width="32dp" android:height="32dp" />
                </shape>
            </item>
            <item
                android:width="24dp"
                android:height="24dp"
                android:gravity="center">
                <shape android:shape="oval">
                    <solid android:color="@color/thumbColorDisabled" />
                    <size android:width="24dp" android:height="24dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:state_checked="true">
        <layer-list>
            <item
                android:width="32dp"
                android:height="32dp"
                android:gravity="center">
                <shape android:shape="oval">
                    <solid android:color="@android:color/transparent" />
                    <size android:width="32dp" android:height="32dp" />
                </shape>
            </item>
            <item
                android:width="24dp"
                android:height="24dp"
                android:gravity="center">
                <shape android:shape="oval">
                    <solid android:color="@color/thumbColorChecked" />
                    <size android:width="24dp" android:height="24dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item
                android:width="32dp"
                android:height="32dp"
                android:gravity="center">
                <shape android:shape="oval">
                    <solid android:color="@android:color/transparent" />
                    <size android:width="32dp" android:height="32dp" />
                </shape>
            </item>
            <item
                android:width="24dp"
                android:height="24dp"
                android:gravity="center">
                <shape android:shape="oval">
                    <solid android:color="@color/thumbColorUnchecked" />
                    <size android:width="24dp" android:height="24dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
