<!-- res/layout/bottom_sheet_model_picker.xml -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:background="@color/xai_canvas"
    tools:context=".BotModelPickerFragment">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:title="Your Models"
        app:titleTextColor="@color/xai_ink"
        android:background="@color/xai_canvas"
        app:navigationIconTint="@color/xai_ink"
        app:menu="@menu/bottom_sheet_model_picker_menu"
        app:navigationIcon="@drawable/is_backarrow" />

    <!-- ConstraintLayout for filter bars -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="8dp">

        <!-- Sort Bar -->
        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/sortBar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/sortAlphabeticalButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Alphabetical"
                app:backgroundTint="@color/toggle_background_selector"
                app:strokeColor="@color/xai_hairline"
                style="@style/Widget.Grokion.Button.OutlinedToggle"
                app:checkedIconVisible="false" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/sortDateButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Newest"
                app:backgroundTint="@color/toggle_background_selector"
                app:strokeColor="@color/xai_hairline"
                style="@style/Widget.Grokion.Button.OutlinedToggle"
                app:checkedIconVisible="false" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <!-- Type Filter Bar -->
        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/filterBar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/sortBar"
            android:layout_marginTop="8dp"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/filterAllButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="All"
                app:backgroundTint="@color/toggle_background_selector"
                app:strokeColor="@color/xai_hairline"
                style="@style/Widget.Grokion.Button.OutlinedToggle"
                app:checkedIconVisible="false" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/filterVisionButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Vision"
                app:backgroundTint="@color/toggle_background_selector"
                app:strokeColor="@color/xai_hairline"
                style="@style/Widget.Grokion.Button.OutlinedToggle"
                app:checkedIconVisible="false" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/filterImageGenButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Image Gen"
                app:backgroundTint="@color/toggle_background_selector"
                app:strokeColor="@color/xai_hairline"
                style="@style/Widget.Grokion.Button.OutlinedToggle"
                app:checkedIconVisible="false" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/filterTranscriptionButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Transc."
                app:backgroundTint="@color/toggle_background_selector"
                app:strokeColor="@color/xai_hairline"
                style="@style/Widget.Grokion.Button.OutlinedToggle"
                app:checkedIconVisible="false" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <!-- Cost Filter Bar -->
        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/costFilterBar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/filterBar"
            android:layout_marginTop="8dp"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/costFilterAllButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="All"
                app:backgroundTint="@color/toggle_background_selector"
                app:strokeColor="@color/xai_hairline"
                style="@style/Widget.Grokion.Button.OutlinedToggle"
                app:checkedIconVisible="false" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/costFilterFreeButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Free"
                app:backgroundTint="@color/toggle_background_selector"
                app:strokeColor="@color/xai_hairline"
                style="@style/Widget.Grokion.Button.OutlinedToggle"
                app:checkedIconVisible="false" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/costFilterPaidButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Paid"
                app:backgroundTint="@color/toggle_background_selector"
                app:strokeColor="@color/xai_hairline"
                style="@style/Widget.Grokion.Button.OutlinedToggle"
                app:checkedIconVisible="false" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <!-- Source Filter Bar -->
        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/sourceFilterBar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/costFilterBar"
            android:layout_marginTop="8dp"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/sourceFilterAllButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="All"
                app:backgroundTint="@color/toggle_background_selector"
                app:strokeColor="@color/xai_hairline"
                style="@style/Widget.Grokion.Button.OutlinedToggle"
                app:checkedIconVisible="false" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/sourceFilterLanButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="LAN"
                app:backgroundTint="@color/toggle_background_selector"
                app:strokeColor="@color/xai_hairline"
                style="@style/Widget.Grokion.Button.OutlinedToggle"
                app:checkedIconVisible="false" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/sourceFilterCloudButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Cloud"
                app:backgroundTint="@color/toggle_background_selector"
                app:strokeColor="@color/xai_hairline"
                style="@style/Widget.Grokion.Button.OutlinedToggle"
                app:checkedIconVisible="false" />
        </com.google.android.material.button.MaterialButtonToggleGroup>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewModels"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:cacheColorHint="@android:color/transparent"
        android:background="@color/xai_canvas"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        android:scrollbars="vertical"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/fabAddModel"
        style="@style/Widget.Grokion.Button.Text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Add"
        android:contentDescription="Add Model" />

</LinearLayout>
