<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="10dp"
    android:paddingBottom="6dp">

    <!-- Grok: full-width assistant text, no bubble chrome -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/aiGroup"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_percent="1.0"
        app:layout_constraintHorizontal_bias="0.0">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/messageContainer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_ai_message"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintHorizontal_bias="0.0">

            <!-- NEW: ImageView for generated images -->
            <ImageView
                android:id="@+id/generatedImageView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="4dp"
                android:layout_marginTop="8dp"
                android:adjustViewBounds="true"
                android:maxHeight="300dp"
                android:scaleType="centerInside"
                android:visibility="gone"
                app:layout_constrainedWidth="true"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/messageTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="start|top"
                android:text="AI message here"
                android:textColor="@color/xai_body"
                android:textColorLink="@color/xai_link"
                android:textIsSelectable="true"
                android:textSize="16sp"
                android:lineSpacingMultiplier="1.15"
                android:linksClickable="true"
                app:layout_constrainedWidth="true"
                app:layout_constraintHorizontal_bias="0.0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/generatedImageView" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Buttons moved below messageContainer, at bottom edge OLD color #454545-->
        <ImageButton
            android:id="@+id/copyButton"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginBottom="4dp"
            android:layout_marginStart="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Copy text"
            android:padding="4dp"
            android:src="@drawable/ic_tune"
            app:tint="@color/xai_icon"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/messageContainer" />
        <ImageButton
            android:id="@+id/editButton"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="8dp"
            android:layout_marginBottom="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Edit message"
            android:padding="4dp"
            app:layout_constraintStart_toEndOf="@id/copyButton"
            app:layout_constraintTop_toBottomOf="@id/messageContainer"
            android:src="@drawable/ic_edit"
            android:visibility="visible"
            app:tint="@color/xai_icon" />
        <!-- Export buttons hidden by default for a clean Grok-like look -->
        <ImageButton
            android:id="@+id/aipdfButton"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="8dp"
            android:layout_marginBottom="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Make PDF"
            android:padding="4dp"
            android:src="@drawable/ic_pdfnew"
            android:visibility="gone"
            app:tint="@color/xai_icon"
            app:layout_constraintStart_toEndOf="@id/editButton"
            app:layout_constraintTop_toBottomOf="@id/messageContainer" />
        <ImageButton
            android:id="@+id/markdownButton"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="8dp"
            android:layout_marginBottom="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Make MD"
            android:padding="4dp"
            android:src="@drawable/ic_markdown"
            android:visibility="gone"
            app:tint="@color/xai_icon"
            app:layout_constraintStart_toEndOf="@id/aipdfButton"
            app:layout_constraintTop_toBottomOf="@id/messageContainer" />
        <ImageButton
            android:id="@+id/pngButton"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="8dp"
            android:layout_marginBottom="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Make MD"
            android:padding="4dp"
            android:src="@drawable/ic_png"
            android:visibility="gone"
            app:tint="@color/xai_icon"
            app:layout_constraintStart_toEndOf="@id/markdownButton"
            app:layout_constraintTop_toBottomOf="@id/messageContainer" />
        <ImageButton
            android:id="@+id/htmlButton"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="8dp"
            android:layout_marginBottom="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="View in HTML (scrollable code/tables)"
            android:padding="4dp"
            android:src="@drawable/ic_html"
            android:visibility="gone"
            app:tint="@color/xai_icon"
            app:layout_constraintStart_toEndOf="@id/pngButton"
            app:layout_constraintTop_toBottomOf="@id/messageContainer" />

        <ImageButton
            android:id="@+id/shareButton"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="8dp"
            android:layout_marginBottom="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Share text"
            android:padding="4dp"
            android:src="@drawable/ic_share"
            app:tint="@color/xai_icon"
            app:layout_constraintStart_toEndOf="@id/htmlButton"
            app:layout_constraintTop_toBottomOf="@id/messageContainer" />

        <!-- ttsButton -->
        <ImageButton
            android:id="@+id/ttsButton"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="8dp"
            android:layout_marginBottom="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Speak text"
            android:padding="4dp"
            android:src="@drawable/ic_volume_up"
            app:tint="@color/xai_icon"
            app:layout_constraintStart_toEndOf="@id/shareButton"
            app:layout_constraintTop_toBottomOf="@id/messageContainer" />
        <ImageButton
            android:id="@+id/saveFileButton"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="8dp"
            android:layout_marginBottom="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Save as file"
            android:padding="4dp"
            android:src="@drawable/ic_filesave"
            android:visibility="gone"
            app:tint="@color/xai_icon"
            app:layout_constraintStart_toEndOf="@id/ttsButton"
            app:layout_constraintTop_toBottomOf="@id/messageContainer" />
        <ImageButton
            android:id="@+id/collapseToggleButton"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="8dp"
            android:layout_marginBottom="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Toggle expand"
            android:padding="4dp"
            android:src="@drawable/ic_expand_more"
            android:visibility="visible"
            app:tint="@color/xai_icon"
            app:layout_constraintStart_toEndOf="@id/saveFileButton"
            app:layout_constraintTop_toBottomOf="@id/messageContainer" />


    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
