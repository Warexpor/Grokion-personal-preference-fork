<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="6dp"
    android:paddingEnd="6dp"
    android:paddingTop="10dp"
    android:paddingBottom="6dp">

    <!-- Grok: full-width assistant text, no bubble chrome -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/aiGroup"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_percent="1.0"
        app:layout_constraintHorizontal_bias="0.0">

        <!-- Collapsible reasoning / thinking block (Grok-style) -->
        <LinearLayout
            android:id="@+id/reasoningBlock"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:layout_marginBottom="8dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <LinearLayout
                android:id="@+id/reasoningHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_reasoning_header"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <ImageView
                    android:id="@+id/reasoningChevron"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_expand_more"
                    app:tint="@color/xai_mute"
                    android:contentDescription="Toggle reasoning" />

                <TextView
                    android:id="@+id/reasoningTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Thinking"
                    android:textColor="@color/xai_mute"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/reasoningTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="8dp"
                android:paddingBottom="4dp"
                android:textColor="@color/xai_mute"
                android:textSize="13sp"
                android:lineSpacingMultiplier="1.55"
                android:visibility="gone"
                android:textIsSelectable="true" />
        </LinearLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/messageContainer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_ai_message"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/reasoningBlock"
            app:layout_constraintHorizontal_bias="0.0">

            <!-- NEW: ImageView for generated images -->
            <ImageView
                android:id="@+id/generatedImageView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="4dp"
                android:layout_marginTop="8dp"
                android:adjustViewBounds="true"
                android:maxHeight="300dp"
                android:scaleType="centerInside"
                android:visibility="gone"
                app:layout_constrainedWidth="true"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/messageTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="start|top"
                android:text="AI message here"
                android:textColor="@color/xai_body"
                android:textColorLink="@color/xai_link"
                android:textColorHighlight="@color/xai_text_highlight"
                android:textIsSelectable="true"
                android:textSize="16sp"
                android:lineSpacingMultiplier="1.55"
                android:linksClickable="true"
                app:layout_constrainedWidth="true"
                app:layout_constraintHorizontal_bias="0.0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/generatedImageView" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Equal-gap action row (Grok order: copy, share, tts, regenerate + local extras) -->
        <LinearLayout
            android:id="@+id/aiActionRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="2dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/messageContainer">

            <ImageButton
                android:id="@+id/copyButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Copy text"
                android:padding="10dp"
                android:src="@drawable/ic_copi"
                app:tint="@color/xai_icon" />

            <ImageButton
                android:id="@+id/shareButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Share text"
                android:padding="10dp"
                android:src="@drawable/ic_share"
                app:tint="@color/xai_icon" />

            <ImageButton
                android:id="@+id/ttsButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Speak text"
                android:padding="10dp"
                android:src="@drawable/ic_volume_up"
                app:tint="@color/xai_icon" />

            <ImageButton
                android:id="@+id/regenerateButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Regenerate response"
                android:padding="10dp"
                android:src="@drawable/ic_redo"
                app:tint="@color/xai_icon" />

            <ImageButton
                android:id="@+id/editButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Edit message"
                android:padding="10dp"
                android:src="@drawable/ic_edit"
                android:visibility="visible"
                app:tint="@color/xai_icon" />

            <ImageButton
                android:id="@+id/aipdfButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Make PDF"
                android:padding="10dp"
                android:src="@drawable/ic_pdfnew"
                android:visibility="gone"
                app:tint="@color/xai_icon" />

            <ImageButton
                android:id="@+id/markdownButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Make MD"
                android:padding="10dp"
                android:src="@drawable/ic_markdown"
                android:visibility="gone"
                app:tint="@color/xai_icon" />

            <ImageButton
                android:id="@+id/pngButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Make PNG"
                android:padding="10dp"
                android:src="@drawable/ic_png"
                android:visibility="gone"
                app:tint="@color/xai_icon" />

            <ImageButton
                android:id="@+id/htmlButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="View in HTML (scrollable code/tables)"
                android:padding="10dp"
                android:src="@drawable/ic_html"
                android:visibility="gone"
                app:tint="@color/xai_icon" />

            <ImageButton
                android:id="@+id/saveFileButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Save as file"
                android:padding="10dp"
                android:src="@drawable/ic_filesave"
                android:visibility="gone"
                app:tint="@color/xai_icon" />

            <ImageButton
                android:id="@+id/collapseToggleButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Toggle expand"
                android:padding="10dp"
                android:src="@drawable/ic_expand_more"
                android:visibility="visible"
                app:tint="@color/xai_icon" />
        </LinearLayout>

        <!-- Stub sources/citations (GONE). Layouts: item_sources_strip / item_citation_card -->
        <LinearLayout
            android:id="@+id/sourcesStubContainer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:layout_marginTop="8dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/aiActionRow">

            <include layout="@layout/item_sources_strip" />
            <include layout="@layout/item_citation_card" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
