<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_bottom_sheet"
    android:paddingTop="12dp"
    android:paddingBottom="20dp"
    android:paddingStart="8dp"
    android:paddingEnd="8dp">

    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="12dp"
        android:background="@color/xai_mute"
        android:alpha="0.4" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/attachCamera"
        style="@style/Widget.Grokion.Button.Text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="start|center_vertical"
        android:minHeight="52dp"
        android:text="@string/grok_attach_camera"
        android:textColor="@color/xai_ink"
        android:textSize="16sp"
        app:icon="@drawable/ic_imgup"
        app:iconTint="@color/xai_ink"
        app:iconGravity="start"
        app:iconPadding="16dp"
        app:rippleColor="@color/press_ripple_none" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/attachGallery"
        style="@style/Widget.Grokion.Button.Text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="start|center_vertical"
        android:minHeight="52dp"
        android:text="@string/grok_attach_gallery"
        android:textColor="@color/xai_ink"
        android:textSize="16sp"
        app:icon="@drawable/ic_imgup"
        app:iconTint="@color/xai_ink"
        app:iconGravity="start"
        app:iconPadding="16dp"
        app:rippleColor="@color/press_ripple_none" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/attachFiles"
        style="@style/Widget.Grokion.Button.Text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="start|center_vertical"
        android:minHeight="52dp"
        android:text="@string/grok_attach_files"
        android:textColor="@color/xai_ink"
        android:textSize="16sp"
        app:icon="@drawable/ic_attachdoc"
        app:iconTint="@color/xai_ink"
        app:iconGravity="start"
        app:iconPadding="16dp"
        app:rippleColor="@color/press_ripple_none" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/attachSystemMessage"
        style="@style/Widget.Grokion.Button.Text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="start|center_vertical"
        android:minHeight="52dp"
        android:text="@string/settings_system_messages"
        android:textColor="@color/xai_ink"
        android:textSize="16sp"
        app:icon="@drawable/ic_tune"
        app:iconTint="@color/xai_ink"
        app:iconGravity="start"
        app:iconPadding="16dp"
        app:rippleColor="@color/press_ripple_none" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/attachTools"
        style="@style/Widget.Grokion.Button.Text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="start|center_vertical"
        android:minHeight="52dp"
        android:text="@string/settings_manage_tools"
        android:textColor="@color/xai_ink"
        android:textSize="16sp"
        app:icon="@drawable/ic_tools"
        app:iconTint="@color/xai_ink"
        app:iconGravity="start"
        app:iconPadding="16dp"
        app:rippleColor="@color/press_ripple_none" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/attachMore"
        style="@style/Widget.Grokion.Button.Text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="start|center_vertical"
        android:minHeight="52dp"
        android:text="More"
        android:textColor="@color/xai_mute"
        android:textSize="15sp"
        app:icon="@drawable/ic_chevron_right"
        app:iconTint="@color/xai_mute"
        app:iconGravity="end"
        app:iconPadding="16dp"
        app:rippleColor="@color/press_ripple_none" />

</LinearLayout>
