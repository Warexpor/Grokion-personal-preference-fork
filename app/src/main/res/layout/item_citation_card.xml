<?xml version="1.0" encoding="utf-8"?>
<!-- Stub: citation card placeholders (no live X API). Wire into ChatAdapter later. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/citationCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_citation_card"
    android:padding="14dp"
    android:layout_marginTop="6dp"
    android:layout_marginBottom="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/citationAvatar"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_person"
            android:contentDescription="@null"
            app:tint="@color/xai_mute"
            android:background="@drawable/bg_history_search"
            android:padding="4dp"
            android:scaleType="centerInside" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/citationName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Grok"
                android:textColor="@color/xai_ink"
                android:textSize="14sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/citationHandle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="\@grok · 2h"
                android:textColor="@color/xai_mute"
                android:textSize="13sp"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/citationBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Placeholder citation body. Connect X / web sources later — this card is a layout stub only."
        android:textColor="@color/xai_body"
        android:textSize="14sp"
        android:maxLines="4"
        android:ellipsize="end"
        android:lineSpacingMultiplier="1.35" />
</LinearLayout>
