<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/xai_canvas"
    android:fitsSystemWindows="true"
    android:padding="16dp"
    tools:context=".SettingsDetailFragment">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:title="Settings"
        app:titleTextColor="@color/xai_ink"
        android:background="@color/xai_canvas"
        app:navigationIcon="@drawable/is_backarrow"
        app:navigationIconTint="@color/xai_ink" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/hapticsSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="16dp"
                    android:gravity="center_vertical">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/settings_haptic_buttons"
                        android:textColor="@color/xai_ink"
                        android:textSize="16sp"
 />
                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/hapticButtonsSwitch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="16dp"
                    android:gravity="center_vertical">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/settings_haptic_responding"
                        android:textColor="@color/xai_ink"
                        android:textSize="16sp"
 />
                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/hapticRespondingSwitch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true" />
                </LinearLayout>
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/lanButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="LAN Settings"
                app:icon="@drawable/ic_lan"
                app:iconSize="22dp"
                app:iconTint="@color/xai_icon"
                app:iconTintMode="src_in"
                app:iconGravity="start"
                app:iconPadding="12dp"
                android:textColor="@color/xai_ink"
                style="@style/Widget.Material3.Button.TextButton"
                android:minHeight="52dp"
                app:backgroundTint="@android:color/transparent"
                app:rippleColor="@color/xai_canvas_soft" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="16dp"
                android:gravity="center_vertical">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Trust self-signed LAN TLS:"
                    android:textColor="@color/xai_ink"
                    android:textSize="16sp"
 />
                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/trustSelfSignedLanSwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="false" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="16dp"
                android:gravity="center_vertical">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Allow destructive file tools:"
                    android:textColor="@color/xai_ink"
                    android:textSize="16sp"
 />
                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/allowDestructiveToolsSwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="false" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/toolsButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Manage AI Tools"
                app:icon="@drawable/ic_tools"
                app:iconSize="22dp"
                app:iconTint="@color/xai_icon"
                app:iconTintMode="src_in"
                app:iconGravity="start"
                app:iconPadding="12dp"
                android:textColor="@color/xai_ink"
                style="@style/Widget.Material3.Button.TextButton"
                android:minHeight="52dp"
                app:backgroundTint="@android:color/transparent"
                app:rippleColor="@color/xai_canvas_soft" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/promptsButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Prompt Library"
                app:icon="@drawable/ic_prompts"
                app:iconSize="22dp"
                app:iconTint="@color/xai_icon"
                app:iconTintMode="src_in"
                app:iconGravity="start"
                app:iconPadding="12dp"
                android:textColor="@color/xai_ink"
                style="@style/Widget.Material3.Button.TextButton"
                android:minHeight="52dp"
                app:backgroundTint="@android:color/transparent"
                app:rippleColor="@color/xai_canvas_soft" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/presetsButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/settings_presets"
                app:icon="@drawable/ic_presets"
                app:iconSize="22dp"
                app:iconTint="@color/xai_icon"
                app:iconTintMode="src_in"
                app:iconGravity="start"
                app:iconPadding="12dp"
                android:textColor="@color/xai_ink"
                style="@style/Widget.Material3.Button.TextButton"
                android:minHeight="52dp"
                app:backgroundTint="@android:color/transparent"
                app:rippleColor="@color/xai_canvas_soft" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/systemMessagesButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/settings_system_messages"
                app:icon="@drawable/ic_tune"
                app:iconSize="22dp"
                app:iconTint="@color/xai_icon"
                app:iconTintMode="src_in"
                app:iconGravity="start"
                app:iconPadding="12dp"
                android:textColor="@color/xai_ink"
                style="@style/Widget.Material3.Button.TextButton"
                android:minHeight="52dp"
                app:backgroundTint="@android:color/transparent"
                app:rippleColor="@color/xai_canvas_soft" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/advancedReasoningButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/settings_advanced_reasoning"
                app:icon="@drawable/ic_reasoning"
                app:iconSize="22dp"
                app:iconTint="@color/xai_icon"
                app:iconTintMode="src_in"
                app:iconGravity="start"
                app:iconPadding="12dp"
                android:textColor="@color/xai_ink"
                style="@style/Widget.Material3.Button.TextButton"
                android:minHeight="52dp"
                app:backgroundTint="@android:color/transparent"
                app:rippleColor="@color/xai_canvas_soft" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/timeoutButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Request Timeout"
                app:icon="@drawable/ic_timeout"
                app:iconSize="22dp"
                app:iconTint="@color/xai_icon"
                app:iconTintMode="src_in"
                app:iconGravity="start"
                app:iconPadding="12dp"
                android:textColor="@color/xai_ink"
                style="@style/Widget.Material3.Button.TextButton"
                android:minHeight="52dp"
                app:backgroundTint="@android:color/transparent"
                app:rippleColor="@color/xai_canvas_soft" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/maxTokensButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Max Tokens"
                app:icon="@drawable/ic_ruler"
                app:iconSize="22dp"
                app:iconTint="@color/xai_icon"
                app:iconTintMode="src_in"
                app:iconGravity="start"
                app:iconPadding="12dp"
                android:textColor="@color/xai_ink"
                style="@style/Widget.Material3.Button.TextButton"
                android:minHeight="52dp"
                app:backgroundTint="@android:color/transparent"
                app:rippleColor="@color/xai_canvas_soft" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/inferenceParamsButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Inference Parameters"
                app:icon="@drawable/ic_param"
                app:iconSize="22dp"
                app:iconTint="@color/xai_icon"
                app:iconTintMode="src_in"
                app:iconGravity="start"
                app:iconPadding="12dp"
                android:textColor="@color/xai_ink"
                style="@style/Widget.Material3.Button.TextButton"
                android:minHeight="52dp"
                app:backgroundTint="@android:color/transparent"
                app:rippleColor="@color/xai_canvas_soft" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/apiKeyButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="OpenRouter API Key"
                app:icon="@drawable/ic_key"
                app:iconSize="22dp"
                app:iconTint="@color/xai_icon"
                app:iconTintMode="src_in"
                app:iconGravity="start"
                app:iconPadding="12dp"
                android:textColor="@color/xai_ink"
                style="@style/Widget.Material3.Button.TextButton"
                android:minHeight="52dp"
                app:backgroundTint="@android:color/transparent"
                app:rippleColor="@color/xai_canvas_soft" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/braveApiKeyButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Brave Search API Key"
                app:icon="@drawable/ic_key"
                app:iconSize="22dp"
                app:iconTint="@color/xai_icon"
                app:iconTintMode="src_in"
                app:iconGravity="start"
                app:iconPadding="12dp"
                android:textColor="@color/xai_ink"
                style="@style/Widget.Material3.Button.TextButton"
                android:minHeight="52dp"
                app:backgroundTint="@android:color/transparent"
                app:rippleColor="@color/xai_canvas_soft" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/creditsButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Check Remaining Credits"
                app:icon="@drawable/ic_credits"
                app:iconSize="22dp"
                app:iconTint="@color/xai_icon"
                app:iconTintMode="src_in"
                app:iconGravity="start"
                app:iconPadding="12dp"
                android:textColor="@color/xai_ink"
                style="@style/Widget.Material3.Button.TextButton"
                android:minHeight="52dp"
                app:backgroundTint="@android:color/transparent"
                app:rippleColor="@color/xai_canvas_soft" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/helpButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Help Screen"
                app:icon="@drawable/ic_help"
                app:iconSize="22dp"
                app:iconTint="@color/xai_icon"
                app:iconTintMode="src_in"
                app:iconGravity="start"
                app:iconPadding="12dp"
                android:textColor="@color/xai_ink"
                style="@style/Widget.Material3.Button.TextButton"
                android:minHeight="52dp"
                app:backgroundTint="@android:color/transparent"
                app:rippleColor="@color/xai_canvas_soft" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/licensesButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/settings_licenses"
                app:icon="@drawable/ic_help"
                app:iconSize="22dp"
                app:iconTint="@color/xai_icon"
                app:iconTintMode="src_in"
                app:iconGravity="start"
                app:iconPadding="12dp"
                android:textColor="@color/xai_ink"
                style="@style/Widget.Material3.Button.TextButton"
                android:minHeight="52dp"
                app:backgroundTint="@android:color/transparent"
                app:rippleColor="@color/xai_canvas_soft" />

            <LinearLayout
                android:id="@+id/chatMemoryRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="16dp"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Chat Memory:"
                    android:textColor="@color/xai_ink"
                    android:textSize="16sp"
 />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/chatMemoryButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="8 messages"
                    android:textColor="@color/xai_ink"
                    style="@style/Widget.Material3.Button.TextButton"
                android:minHeight="52dp"
                app:backgroundTint="@android:color/transparent"
                app:rippleColor="@color/xai_canvas_soft" />
            </LinearLayout>
            <!-- Appearance: theme + preview -->
            <TextView
                android:id="@+id/appearanceSectionLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/grok_appearance"
                android:textColor="@color/xai_ink"
                android:textSize="16sp"
 />

            <LinearLayout
                android:id="@+id/appearancePreviewCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical"
                android:background="@drawable/bg_appearance_preview"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:background="@drawable/bg_user_message"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp"
                    android:maxWidth="280dp"
                    android:text="@string/grok_appearance_preview_user"
                    android:textColor="@color/xai_ink"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/grok_appearance_preview_grok"
                    android:textColor="@color/xai_body"
                    android:textSize="14sp"
                    android:lineSpacingMultiplier="1.55" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/themeModeRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Theme Mode:"
                    android:textColor="@color/xai_ink"
                    android:textSize="16sp"
 />

                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/themeToggleGroup"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:singleSelection="true"
                    app:selectionRequired="true">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnThemeSystem"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:backgroundTint="@color/toggle_background_selector"
                        app:strokeColor="@color/chestnut"
                        android:text="System" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnThemeLight"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:backgroundTint="@color/toggle_background_selector"
                        app:strokeColor="@color/chestnut"
                        android:text="Light" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnThemeDark"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:backgroundTint="@color/toggle_background_selector"
                        app:strokeColor="@color/chestnut"
                        android:text="Dark" />

                </com.google.android.material.button.MaterialButtonToggleGroup>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="16dp"
                android:gravity="center_vertical">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Extended Dock:"
                    android:textColor="@color/xai_ink"
                    android:textSize="16sp"
 />
                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/extendedDockSwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="false" />
            </LinearLayout>



            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="16dp"
                android:gravity="center_vertical">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Expand Input on Focus:"
                    android:textColor="@color/xai_ink"
                    android:textSize="16sp"
 />
                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/expandableInputSwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="false" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="16dp"
                android:gravity="center_vertical">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Scroll Progress Indicator:"
                    android:textColor="@color/xai_ink"
                    android:textSize="16sp"
 />
                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/scrollProgressSwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    app:useMaterialThemeColors="true" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="16dp"
                android:gravity="center_vertical">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Scroll to Top/Bottom Buttons:"
                    android:textColor="@color/xai_ink"
                    android:textSize="16sp"
 />
                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/scrollButtonsSwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="false" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="16dp"
                android:gravity="center_vertical">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Volume Keys Scroll to Top/Bottom:"
                    android:textColor="@color/xai_ink"
                    android:textSize="16sp"
 />
                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/volumeScrollSwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="false" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="16dp"
                android:gravity="center_vertical">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Presets Button on Chat Screen:"
                    android:textColor="@color/xai_ink"
                    android:textSize="16sp"
 />
                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/presetsExtendedSwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="false" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="16dp"
                android:gravity="center_vertical">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Keep Screen On:"
                    android:textColor="@color/xai_ink"
                    android:textSize="16sp"
 />
                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/keepScreenOnSwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="false" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="16dp"
                android:gravity="center_vertical">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Biometrics Check:"
                    android:textColor="@color/xai_ink"
                    android:textSize="16sp"
 />
                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/biometricsSwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="false" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="16dp"
                android:gravity="center_vertical">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Notifications:"
                    android:textColor="@color/xai_ink"
                    android:textSize="16sp"
 />
                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/notificationsSwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    app:useMaterialThemeColors="true" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="16dp"
                android:gravity="center_vertical">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Auto-disable Web Search:"
                    android:textColor="@color/xai_ink"
                    android:textSize="16sp"
 />
                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/autoDisableWebSearchSwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    app:useMaterialThemeColors="true" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="16dp"
                android:gravity="center_vertical">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Extended Top Bar:"
                    android:textColor="@color/xai_ink"
                    android:textSize="16sp"
 />
                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/extendedTopBarSwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="false" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="16dp"
                android:gravity="center_vertical">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Show Citations:"
                    android:textColor="@color/xai_ink"
                    android:textSize="16sp"
 />
                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/showCitationsSwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="false" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="16dp"
                android:gravity="center_vertical">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Copy Button on Notification(instead of Dismiss):"
                    android:textColor="@color/xai_ink"
                    android:textSize="16sp"
 />
                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/copyOrdismissSwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="false" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="16dp"
                android:gravity="center_vertical">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Copy Button on Notification(instead of Open):"
                    android:textColor="@color/xai_ink"
                    android:textSize="16sp"
 />
                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/copyOropenSwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="false" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="16dp"
                android:gravity="center_vertical">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Auto Save Chats:"
                    android:textColor="@color/xai_ink"
                    android:textSize="16sp"
 />
                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/autoSaveChatsSwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="false" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="16dp"
                android:gravity="center_vertical">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="OpenRouter Middle-Out Transform:"
                    android:textColor="@color/xai_ink"
                    android:textSize="16sp"
 />
                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/openRouterTransformsSwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="false" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="16dp"
                android:gravity="center_vertical">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Animate border on new message:"
                    android:textColor="@color/xai_ink"
                    android:textSize="16sp"
 />
                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/animateBarOnErrorSwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    app:useMaterialThemeColors="true" />
            </LinearLayout>

            <TextView
                android:id="@+id/voiceSectionHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Voice Input (STT)"
                android:textColor="@color/xai_ink"
                android:textSize="18sp"
 />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/voiceModelInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="STT Model ID (e.g., Qwen3-ASR-1.7B-8bit)"
                app:boxStrokeColor="?attr/colorOutline"
                app:hintTextColor="?android:attr/textColorSecondary"
                android:textColorHint="?android:attr/textColorSecondary">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/voiceInputModelEdit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/xai_ink"
                    android:inputType="text" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/voiceInputProviderToggle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:singleSelection="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/providerLanButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="LAN"
                    style="?attr/materialButtonOutlinedStyle"
                    app:backgroundTint="@color/toggle_background_selector"
                    app:strokeColor="@color/chestnut"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/providerCloudButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Cloud"
                    style="?attr/materialButtonOutlinedStyle"
                    app:backgroundTint="@color/toggle_background_selector"
                    app:strokeColor="@color/chestnut"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/providerOffButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Off"
                    style="?attr/materialButtonOutlinedStyle"
                    app:backgroundTint="@color/toggle_background_selector"
                    app:strokeColor="@color/chestnut"/>
            </com.google.android.material.button.MaterialButtonToggleGroup>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Watermark Transcription:"
                    android:textColor="@color/xai_ink"
                    android:textSize="16sp"
 />
                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/watermarkSttSwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="false" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>